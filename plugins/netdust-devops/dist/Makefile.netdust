# ─────────────────────────────────────────────────────────────────────────────
# Makefile.netdust — the Netdust devops core. Stack-agnostic.
#
# DO NOT EDIT THIS FILE IN A PROJECT. It is vendored from the netdust-devops
# plugin and `make devops-update` overwrites it. Project-specific targets and
# variable overrides belong in the project's own `Makefile`, which includes
# this one.
#
# Everything here resolves from site.yml — no host, path, branch or domain is
# ever written in a Makefile. `scripts/site <dotted.key>` is the only reader.
#
# Layering:
#   Makefile            (project)  — STACK + project-specific targets
#     └── Makefile.netdust         — flow, deploy, ledger, health   ← this file
#           └── mk/$(STACK).mk     — local loop + data ops per stack
# ─────────────────────────────────────────────────────────────────────────────

SITE := scripts/site

PROJECT_NAME := $(shell $(SITE) site.name)
WEBROOT      := $(shell $(SITE) structure.webroot)

# Branch names are derived from the environments — never written twice.
# A project without a development environment integrates on its review branch;
# one without production yet promotes as far as it has rungs.
BR_PROD   := $(shell $(SITE) environments.production.branch 2>/dev/null || $(SITE) environments.staging.branch 2>/dev/null)
BR_REVIEW := $(shell $(SITE) environments.staging.branch 2>/dev/null || $(SITE) environments.production.branch 2>/dev/null)
BR_INTEG  := $(shell $(SITE) environments.development.branch 2>/dev/null || $(SITE) environments.staging.branch 2>/dev/null || $(SITE) environments.production.branch 2>/dev/null)
HAS_PROD  := $(shell $(SITE) environments.production.path >/dev/null 2>&1 && echo yes || echo no)

STACK ?= $(shell $(SITE) structure.stack 2>/dev/null || echo generic)

RED := \033[31m
GREEN := \033[32m
YELLOW := \033[33m
BLUE := \033[34m
RESET := \033[0m

.DEFAULT_GOAL := help

# Stack layer: local loop (dev/setup/logs) and data ops (pull/refresh/backup).
# It DEFINES the four hooks this file calls (_help-stack, _status-stack,
# _doctor-stack, _backup-data) — no defaults are declared here, because a
# default recipe would silently win over the stack's and make would only warn.
# An unknown stack falls back to generic.mk rather than failing to parse.
STACK_MK := $(firstword $(wildcard mk/$(STACK).mk) mk/generic.mk)
include $(STACK_MK)

# ── HELP ─────────────────────────────────────────────────────────────────────

.PHONY: help
help: ## Show this help
	@echo "$(BLUE)$(PROJECT_NAME)$(RESET)  ·  stack: $(STACK)  ·  netdust-devops $$(cat .netdust-devops 2>/dev/null | head -1 || echo '?')"
	@echo ""
	@$(MAKE) --no-print-directory _flow-state
	@echo ""
	@echo "$(YELLOW)FLOW$(RESET)         one branch per environment; the verbs are the only door to a rung"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "feature name=X"  "start work — branches from $(BR_INTEG)"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "hotfix name=X"   "fix production — branches from origin/$(BR_PROD)"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "save"            "commit the current branch"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "finish"          "merge one step up the promotion path"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "promote name=X"  "send ONE feature to $(BR_REVIEW)"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "release"         "merge $(BR_REVIEW) into $(BR_PROD)"
	@echo ""
	@echo "$(YELLOW)DEPLOY$(RESET)       gate → transport → stamp; nothing uncommitted or unpushed ships"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "deploy-test env=E" "dry run — read the deletions"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "deploy env=E"      "gate, transport, stamp"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "ship"              "production: gate, backups, typed confirm"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "rollback env=E"    "redeploy the previously stamped commit"
	@echo ""
	@echo "$(YELLOW)INSPECT$(RESET)      read-only — safe to run anywhere, any time"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "status"   "branch, flow position, what runs where"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "deployed" "which commit runs on each environment"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "health"   "ledger, server drift, guards, topology, patched files"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "doctor"   "tools, SSH reachability, payload"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "audit"    "work that exists only on this machine"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "test"     "flow + deploy tooling tests (no server contact)"
	@printf "  $(GREEN)%-22s$(RESET) %s\n" "gate"     "this project's own suite (commands.gate)"
	@echo ""
	@$(MAKE) --no-print-directory _help-stack
	@echo "$(BLUE)Path:$(RESET) feature name=X → finish → deploy env=development → promote name=X → deploy env=staging → release → ship"

# ── FLOW ─────────────────────────────────────────────────────────────────────

.PHONY: save
save: ## Commit the current branch (auto-stages all changes)
	@$(MAKE) --no-print-directory _ensure-safe-branch
	@if [ -z "$$(git status --porcelain 2>/dev/null)" ]; then \
		echo "$(YELLOW)No changes to save$(RESET)"; \
	else \
		git add -A; \
		echo "$(YELLOW)Changes to commit:$(RESET)"; \
		git status --short; \
		$(MAKE) --no-print-directory _need-tty verb=save; \
		read -p "Commit message: " msg && \
		if [ -n "$$msg" ]; then \
			git commit -m "$$msg" && echo "$(GREEN)✅ Saved: $$msg$(RESET)"; \
		else \
			echo "$(RED)❌ Commit cancelled$(RESET)"; exit 1; \
		fi; \
	fi

.PHONY: feature
feature: ## Start a feature (make feature name=my-feature) — branches from the integration branch
	@if [ -z "$(name)" ]; then echo "$(RED)Usage: make feature name=my-feature$(RESET)"; exit 1; fi
	@if ! echo "$(name)" | grep -qE '^[a-zA-Z][a-zA-Z0-9._-]*$$'; then \
		echo "$(RED)✗ Invalid name: use letters, digits, dot, dash, underscore$(RESET)"; exit 1; fi
	@$(MAKE) --no-print-directory _ensure-flow
	@$(MAKE) --no-print-directory _ensure-clean-git
	@git fetch --quiet origin $(BR_INTEG)
	@git checkout -b "feature/$(name)" origin/$(BR_INTEG)
	@echo "$(GREEN)✅ On feature/$(name), branched from origin/$(BR_INTEG)$(RESET)"

.PHONY: hotfix
hotfix: ## Start a hotfix (make hotfix name=vat-rounding) — branches from the production branch
	@if [ -z "$(name)" ]; then echo "$(RED)Usage: make hotfix name=my-fix$(RESET)"; exit 1; fi
	@if ! echo "$(name)" | grep -qE '^[a-zA-Z][a-zA-Z0-9._-]*$$'; then \
		echo "$(RED)✗ Invalid name: use letters, digits, dot, dash, underscore$(RESET)"; exit 1; fi
	@$(MAKE) --no-print-directory _ensure-flow
	@$(MAKE) --no-print-directory _ensure-clean-git
	@git fetch --quiet origin $(BR_PROD)
	@git checkout -b "hotfix/$(name)" origin/$(BR_PROD)
	@echo "$(GREEN)✅ On hotfix/$(name), branched from origin/$(BR_PROD)$(RESET)"
	@echo "$(YELLOW)   Fix, commit, then: make finish$(RESET)"

.PHONY: finish
finish: ## Merge a branch one step up the promotion path (make finish [name=my-feature])
	@$(MAKE) --no-print-directory _ensure-flow
	@$(MAKE) --no-print-directory _ensure-clean-git
	@: 'name= finishes a branch you are NOT standing on. A parallel agent works'
	@: 'in its own worktree, so the rung it must merge into is checked out'
	@: 'elsewhere and it cannot finish its own work; the worktree holding the'
	@: 'rung can, but it is not on the feature branch. name= is that seam.'
	@BRANCH=$$(git branch --show-current); \
	if [ -n "$(name)" ]; then \
		if git rev-parse --verify --quiet "feature/$(name)" >/dev/null; then BRANCH="feature/$(name)"; \
		elif git rev-parse --verify --quiet "hotfix/$(name)" >/dev/null; then BRANCH="hotfix/$(name)"; \
		else \
			echo "$(RED)✗ No feature/$(name) or hotfix/$(name) in this repository$(RESET)"; \
			echo "$(YELLOW)Branches in flight:$(RESET)"; \
			git branch --list 'feature/*' 'hotfix/*' | sed 's/^/  /'; \
			exit 1; \
		fi; \
		HOLDER=$$(git worktree list --porcelain 2>/dev/null \
			| awk -v b="refs/heads/$$BRANCH" '/^worktree /{w=substr($$0,10)} /^branch /{if ($$2==b) {print w; exit}}'); \
		if [ -n "$$HOLDER" ] && [ -n "$$(git -C "$$HOLDER" status --porcelain)" ]; then \
			echo "$(RED)✗ $$BRANCH has uncommitted changes in $$HOLDER$(RESET)"; \
			echo "$(YELLOW)  Commit them there first: cd $$HOLDER && make save$(RESET)"; \
			exit 1; \
		fi; \
		echo "$(BLUE)finishing $$BRANCH (checked out in $${HOLDER:-no worktree})$(RESET)"; \
	fi; \
	case "$$BRANCH" in \
		hotfix/*) for r in $(BR_PROD) $(BR_REVIEW) $(BR_INTEG); do \
			$(MAKE) --no-print-directory _worktree-guard rung=$$r verb=finish || exit 1; done;; \
		*) $(MAKE) --no-print-directory _worktree-guard rung=$(BR_INTEG) verb=finish || exit 1;; \
	esac; \
	case "$$BRANCH" in \
		feature/*) \
			echo "$(YELLOW)$$BRANCH → $(BR_INTEG)$(RESET)"; \
			git checkout $(BR_INTEG) && git pull --quiet --ff-only && \
			git merge --no-ff "$$BRANCH" -m "Merge $$BRANCH" && \
			git push && \
			{ git branch -d "$$BRANCH" 2>/dev/null || \
			  echo "$(YELLOW)  $$BRANCH kept — it is checked out in a worktree. Remove it with: git worktree remove <path>$(RESET)"; } && \
			echo "$(GREEN)✅ Merged to $(BR_INTEG). Deploy: make deploy env=development$(RESET)";; \
		hotfix/*) \
			echo "$(YELLOW)$$BRANCH → $(BR_PROD), then back down into $(BR_REVIEW) and $(BR_INTEG)$(RESET)"; \
			git checkout $(BR_PROD) && git pull --quiet --ff-only && \
			git merge --no-ff "$$BRANCH" -m "Merge $$BRANCH" && git push && \
			git checkout $(BR_REVIEW) && git pull --quiet --ff-only && \
			git merge --no-ff $(BR_PROD) -m "Merge $(BR_PROD) (hotfix $$BRANCH)" && git push && \
			git checkout $(BR_INTEG) && git pull --quiet --ff-only && \
			git merge --no-ff $(BR_PROD) -m "Merge $(BR_PROD) (hotfix $$BRANCH)" && git push && \
			git checkout $(BR_PROD) && git branch -d "$$BRANCH" && \
			echo "$(GREEN)✅ On $(BR_PROD), merged down into $(BR_REVIEW) and $(BR_INTEG). Ship: make ship$(RESET)";; \
		*) \
			echo "$(RED)✗ finish works on feature/* and hotfix/* — you are on $$BRANCH$(RESET)"; \
			exit 1;; \
	esac

.PHONY: promote
promote: ## Send ONE feature to the review branch, leaving the rest of the integration branch behind
	@if [ -z "$(name)" ]; then echo "$(RED)Usage: make promote name=my-feature$(RESET)"; exit 1; fi
	@$(MAKE) --no-print-directory _ensure-flow
	@git fetch --quiet origin 2>/dev/null || true
	@BR="feature/$(name)"; \
	if ! git rev-parse --verify --quiet "$$BR" >/dev/null && \
	   ! git rev-parse --verify --quiet "origin/$$BR" >/dev/null; then \
		echo "$(RED)✗ No such branch: $$BR$(RESET)"; \
		echo "$(YELLOW)Features in flight:$(RESET)"; \
		git branch -a --list '*feature/*' | sed 's/^/  /'; \
		exit 1; \
	fi
	@$(MAKE) --no-print-directory _ensure-clean-git
	@$(MAKE) --no-print-directory _worktree-guard rung=$(BR_REVIEW) verb="promote name=$(name)"
	@BR="feature/$(name)"; \
	git rev-parse --verify --quiet "$$BR" >/dev/null || git branch "$$BR" "origin/$$BR"; \
	$(MAKE) --no-print-directory _need-tty verb=promote; \
	echo "$(YELLOW)$$BR → $(BR_REVIEW) ($(BR_INTEG) is not merged)$(RESET)"; \
	git --no-pager log --oneline $(BR_REVIEW).."$$BR" | head -20; \
	read -p "Continue? Type 'yes': " reply; \
	if [ "$$reply" != "yes" ]; then echo "$(RED)✗ Cancelled$(RESET)"; exit 1; fi; \
	git checkout $(BR_REVIEW) && git pull --quiet --ff-only && \
	git merge --no-ff "$$BR" -m "Promote $$BR to $(BR_REVIEW)" && git push && \
	echo "$(GREEN)✅ $$BR is on $(BR_REVIEW). Deploy: make deploy env=staging$(RESET)"; \
	echo "$(YELLOW)   $(BR_INTEG) keeps its other features — they are untouched.$(RESET)"

.PHONY: release
release: ## Merge the review branch into the production branch (then: make ship)
	@if [ "$(HAS_PROD)" != "yes" ]; then \
		echo "$(RED)✗ No production environment in site.yml yet$(RESET)"; exit 1; fi
	@$(MAKE) --no-print-directory _ensure-flow
	@$(MAKE) --no-print-directory _need-tty verb=release
	@$(MAKE) --no-print-directory _ensure-clean-git
	@$(MAKE) --no-print-directory _worktree-guard rung=$(BR_REVIEW) verb=release
	@$(MAKE) --no-print-directory _worktree-guard rung=$(BR_PROD) verb=release
	@git fetch --quiet origin
	@git checkout $(BR_REVIEW) && git pull --quiet --ff-only
	@git checkout $(BR_PROD) && git pull --quiet --ff-only
	@echo "$(YELLOW)About to merge $(BR_REVIEW) → $(BR_PROD):$(RESET)"
	@git --no-pager log --oneline $(BR_PROD)..$(BR_REVIEW) | head -30
	@read -p "Continue? Type 'yes': " reply; \
	if [ "$$reply" != "yes" ]; then echo "$(RED)✗ Cancelled$(RESET)"; exit 1; fi
	@git merge --no-ff $(BR_REVIEW) -m "Release: merge $(BR_REVIEW)" && git push
	@echo "$(GREEN)✅ $(BR_PROD) updated. Ship with: make ship$(RESET)"

# ── DEPLOY ───────────────────────────────────────────────────────────────────

.PHONY: deploy
deploy: ## Deploy the payload to an environment (make deploy env=staging)
	@$(MAKE) --no-print-directory _deploy-gate env=$(env)
	@$(MAKE) --no-print-directory _deploy-confirm env=$(env)
	@$(MAKE) --no-print-directory _deploy-transport env=$(env) dryrun="$(dryrun)"
	@if [ -z "$(dryrun)" ]; then $(MAKE) --no-print-directory _deploy-stamp env=$(env); fi
	@if [ -z "$(dryrun)" ]; then $(MAKE) --no-print-directory _deploy-opcache env=$(env); fi
	@echo "$(GREEN)🌐 $$($(SITE) environments.$(env).url)$(RESET)"

.PHONY: deploy-test
deploy-test: ## Show what a deploy would change, without changing it
	@$(MAKE) --no-print-directory deploy env=$(env) dryrun=--dry-run

.PHONY: ship
ship: ## Ship to production (gate, backups, typed confirmation, deploy)
	@if [ "$(HAS_PROD)" != "yes" ]; then \
		echo "$(RED)✗ No production environment in site.yml yet$(RESET)"; \
		echo "$(YELLOW)  Add environments.production once the site is live.$(RESET)"; exit 1; fi
	@: 'The terminal check comes FIRST. Deferring it to _deploy-confirm meant'
	@: 'a piped ship took a production database dump and a payload tarball'
	@: 'before discovering it could never read the confirmation.'
	@: 'Never use backticks in a : comment here - the shell substitutes them.' 
	@$(MAKE) --no-print-directory _need-tty verb=ship
	@$(MAKE) --no-print-directory _deploy-gate env=production
	@$(MAKE) --no-print-directory _backup-data env=production
	@$(MAKE) --no-print-directory _backup-payload env=production
	@$(MAKE) --no-print-directory deploy env=production

.PHONY: rollback
rollback: ## Redeploy the previously deployed commit (make rollback env=production)
	@ENV="$(env)"; \
	if [ -z "$$ENV" ]; then echo "$(RED)✗ Usage: make rollback env=<name>$(RESET)"; exit 1; fi; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	DIR=$$($(SITE) deploy.state_dir); \
	PREV=$$(ssh -qn "$$HOST" "tail -2 $$DIR/$$ENV.log 2>/dev/null | head -1" | awk '{print $$2}'); \
	if [ -z "$$PREV" ]; then \
		echo "$(RED)✗ No previous deploy recorded for $$ENV$(RESET)"; exit 1; fi; \
	$(MAKE) --no-print-directory _need-tty verb="rollback env=$$ENV"; \
	echo "$(YELLOW)Rolling $$ENV back to $$PREV$(RESET)"; \
	git --no-pager log --oneline -1 "$$PREV" || { \
		echo "$(RED)✗ Commit $$PREV is not in this repository$(RESET)"; exit 1; }; \
	read -p "Type 'yes' to roll back: " reply; \
	if [ "$$reply" != "yes" ]; then echo "$(RED)✗ Cancelled$(RESET)"; exit 1; fi; \
	WT=$$(mktemp -d); \
	git worktree add --detach --quiet "$$WT" "$$PREV"; \
	REMOTE=$$($(SITE) environments.$$ENV.path); \
	EXCL=""; \
	set -f; for e in $$($(SITE) deploy.exclude); do EXCL="$$EXCL --exclude=$$e"; done; set +f; \
	for p in $$($(SITE) deploy.payload); do \
		[ -d "$$WT/$(WEBROOT)/$$p" ] || continue; \
		echo "$(BLUE)  → $$p$(RESET)"; \
		rsync -az --delete -e "ssh -q" $$EXCL "$$WT/$(WEBROOT)/$$p/" "$$HOST:$$REMOTE/$$p/" || exit 1; \
	done; \
	git worktree remove --force "$$WT"; \
	WHEN=$$(date -Iseconds); WHO=$$(git config user.name); \
	printf '%s %s %s %s\n' "$$WHEN" "$$PREV" "rollback" "$$WHO" \
		| ssh -q "$$HOST" "cat >> $$DIR/$$ENV.log"; \
	printf '{"sha":"%s","branch":"rollback","at":"%s","by":"%s"}\n' "$$PREV" "$$WHEN" "$$WHO" \
		| ssh -q "$$HOST" "cat > $$DIR/$$ENV.json"; \
	$(MAKE) --no-print-directory _deploy-opcache env=$$ENV; \
	echo "$(GREEN)✅ $$ENV rolled back to $$PREV$(RESET)"

# ── INSPECT (read-only) ──────────────────────────────────────────────────────

.PHONY: deployed
deployed: ## Show which commit runs on each environment
	@DIR=$$($(SITE) deploy.state_dir); \
	for e in $$($(SITE) environments); do \
		H=$$($(SITE) environments.$$e.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
		J=$$(ssh -qn "$$H" "cat $$DIR/$$e.json 2>/dev/null" || true); \
		if [ -z "$$J" ]; then \
			printf "  $(YELLOW)%-12s never deployed with this tool$(RESET)\n" "$$e"; \
		else \
			printf "  $(GREEN)%-12s$(RESET) %s\n" "$$e" "$$J"; \
		fi; \
	done

.PHONY: status
status: ## Branch, flow position, and what runs on each environment
	@$(MAKE) --no-print-directory _flow-state
	@echo ""
	@echo "$(YELLOW)LOCAL$(RESET)"
	@printf "  changes: %s files\n" "$$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
	@printf "  commit:  %s\n" "$$(git log --oneline -1 2>/dev/null | head -c 60 || echo none)"
	@$(MAKE) --no-print-directory _status-stack
	@echo ""
	@echo "$(YELLOW)DEPLOYED$(RESET)"
	@$(MAKE) --no-print-directory deployed

.PHONY: audit
audit: ## Report work that exists only on this machine (never pushes or deletes)
	@bash scripts/work-audit.sh

.PHONY: gate
gate: ## Run this project's own test suite (commands.gate from site.yml)
	@G=$$($(SITE) commands.gate 2>/dev/null); \
	if [ -z "$$G" ]; then echo "$(RED)✗ No commands.gate in site.yml$(RESET)"; exit 1; fi; \
	echo "$(BLUE)$$G$(RESET)"; eval "$$G"

.PHONY: test
test: ## Run the deploy tooling + branch-flow tests (never contacts a server)
	@scripts/tests/deploy-test.sh
	@scripts/tests/flow-test.sh

.PHONY: doctor
doctor: ## Check required tools, SSH reachability, and the payload
	@$(MAKE) --no-print-directory _flow-state
	@echo ""
	@echo "$(BLUE)Tools$(RESET)"
	@for c in git rsync ssh python3; do \
		command -v $$c >/dev/null 2>&1 \
			&& printf "  ✅ %s\n" "$$c" \
			|| printf "  $(RED)❌ %s (required)$(RESET)\n" "$$c"; \
	done
	@python3 -c "import yaml" 2>/dev/null && echo "  ✅ PyYAML (scripts/site)" || echo "  $(RED)❌ PyYAML — scripts/site cannot read site.yml$(RESET)"
	@$(MAKE) --no-print-directory _doctor-stack
	@echo ""
	@echo "$(BLUE)netdust-devops$(RESET)"
	@bash scripts/devops-version --check 2>/dev/null || echo "  $(YELLOW)⚠  not stamped — run: make devops-update$(RESET)"
	@echo ""
	@echo "$(BLUE)Environments (from site.yml)$(RESET)"
	@for e in $$($(SITE) environments); do \
		HOST=$$($(SITE) environments.$$e.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
		P=$$($(SITE) environments.$$e.path); \
		B=$$($(SITE) environments.$$e.branch); \
		U=$$($(SITE) environments.$$e.url); \
		printf "  %-12s %-10s %s\n" "$$e" "$$B" "$$U"; \
		if ssh -qn -o ConnectTimeout=5 "$$HOST" "test -d $$P" 2>/dev/null; then \
			printf "               $(GREEN)path ok$(RESET)  %s\n" "$$P"; \
		else \
			printf "               $(RED)UNREACHABLE$(RESET) %s\n" "$$P"; \
		fi; \
	done
	@echo ""
	@echo "$(BLUE)Payload$(RESET)"
	@for p in $$($(SITE) deploy.payload); do \
		if [ -d "$(WEBROOT)/$$p" ]; then printf "  ✅ %s\n" "$$p"; \
		else printf "  $(RED)❌ %s missing locally$(RESET)\n" "$$p"; fi; \
	done

.PHONY: devops-update
devops-update: ## Re-vendor Makefile.netdust, mk/ and scripts/ from the installed plugin
	@bash scripts/devops-version --update

.PHONY: health
health: ## Ledger, server drift, deploy guards, branch topology, patched files
	@git fetch --quiet origin 2>/dev/null || true
	@echo "$(BLUE)Ledger — is each environment running its branch head?$(RESET)"
	@DIR=$$($(SITE) deploy.state_dir); \
	for e in $$($(SITE) environments); do \
		H=$$($(SITE) environments.$$e.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
		B=$$($(SITE) environments.$$e.branch); \
		S=$$(ssh -qn "$$H" "cat $$DIR/$$e.json 2>/dev/null" | sed -n 's/.*"sha":"\([0-9a-f]*\)".*/\1/p'); \
		HD=$$(git rev-parse --verify --quiet "origin/$$B" || true); \
		if [ -z "$$S" ]; then printf "  $(YELLOW)%-12s never deployed with this tool$(RESET)\n" "$$e"; \
		elif [ "$$S" = "$$HD" ]; then printf "  $(GREEN)%-12s in sync$(RESET)   %s\n" "$$e" "$$B"; \
		else printf "  $(YELLOW)%-12s BEHIND$(RESET)    %s: running %.8s, head %.8s\n" "$$e" "$$B" "$$S" "$$HD"; fi; \
	done
	@echo ""
	@echo "$(BLUE)Drift — has anyone edited a server by hand?$(RESET)"
	@set -f; EXCL=""; for x in $$($(SITE) deploy.exclude 2>/dev/null); do EXCL="$$EXCL --exclude=$$x"; done; set +f; \
	for e in $$($(SITE) environments); do \
		H=$$($(SITE) environments.$$e.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
		R=$$($(SITE) environments.$$e.path); \
		B=$$($(SITE) environments.$$e.branch); \
		git rev-parse --verify --quiet "origin/$$B" >/dev/null || { printf "  $(YELLOW)%-12s no origin/%s$(RESET)\n" "$$e" "$$B"; continue; }; \
		PAY=$$($(SITE) deploy.payload 2>/dev/null); \
		if [ -z "$$PAY" ]; then printf "  $(YELLOW)%-12s n/a$(RESET)      no deploy.payload (transport: %s) — drift is only measurable for rsync\n" "$$e" "$$($(SITE) deploy.method 2>/dev/null || echo unknown)"; continue; fi; \
		TMP=$$(mktemp -d); CH=0; DEL=0; \
		git archive "origin/$$B" | tar -x -C "$$TMP" 2>/dev/null; \
		for pp in $$($(SITE) deploy.payload); do \
			[ -d "$$TMP/$(WEBROOT)/$$pp" ] || continue; \
			O=$$(rsync -az --delete -e "ssh -q" --dry-run --itemize-changes $$EXCL \
				"$$TMP/$(WEBROOT)/$$pp/" "$$H:$$R/$$pp/" 2>/dev/null); \
			CH=$$((CH+$$(printf '%s\n' "$$O" | grep -cE '^[<>]f.s'))); \
			DEL=$$((DEL+$$(printf '%s\n' "$$O" | grep -c '^\*deleting'))); \
		done; \
		rm -rf "$$TMP"; \
		if [ "$$CH" -eq 0 ] && [ "$$DEL" -eq 0 ]; then printf "  $(GREEN)%-12s clean$(RESET)\n" "$$e"; \
		else printf "  $(RED)%-12s DRIFT$(RESET)  %s files differ, %s would be deleted — someone edited the server, or the branch was never deployed\n" "$$e" "$$CH" "$$DEL"; fi; \
	done
	@echo ""
	@echo "$(BLUE)Deploy guards$(RESET)"
	@M=$$($(SITE) deploy.method 2>/dev/null); \
	if [ "$$M" = "rsync" ]; then \
		for g in /memory/ /tasks/; do \
			if $(SITE) deploy.exclude 2>/dev/null | grep -qx "$$g"; then printf "  $(GREEN)✅ %s excluded$(RESET)\n" "$$g"; \
			else printf "  $(RED)❌ %s NOT in deploy.exclude — agent notes would be published to the web root$(RESET)\n" "$$g"; fi; \
		done; \
	else \
		for g in memory tasks; do \
			if [ -f .gitignore ] && grep -qE "^/?$$g/?$$" .gitignore; then printf "  $(GREEN)✅ %s/ gitignored$(RESET)\n" "$$g"; \
			else printf "  $(RED)❌ %s/ not gitignored — a %s deploy carries it to the server$(RESET)\n" "$$g" "$$M"; fi; \
		done; \
	fi
	@echo ""
	@echo "$(BLUE)Branch topology$(RESET)"
	@if [ "$(HAS_PROD)" = "yes" ]; then \
		for b in $(BR_REVIEW) $(BR_INTEG); do \
			[ "$$b" = "$(BR_PROD)" ] && continue; \
			N=$$(git rev-list --count "origin/$(BR_PROD)" "^origin/$$b" 2>/dev/null || echo "?"); \
			if [ "$$N" = "0" ]; then printf "  $(GREEN)✅ %s contains %s$(RESET)\n" "$$b" "$(BR_PROD)"; \
			else printf "  $(RED)❌ %s is missing %s commits from %s — production work can be reverted$(RESET)\n" "$$b" "$$N" "$(BR_PROD)"; fi; \
		done; \
	fi
	@if [ "$(BR_REVIEW)" != "$(BR_INTEG)" ]; then \
		N=$$(git rev-list --count "origin/$(BR_REVIEW)" "^origin/$(BR_INTEG)" 2>/dev/null || echo "?"); \
		if [ "$$N" = "0" ]; then printf "  $(GREEN)✅ %s contains %s$(RESET)\n" "$(BR_INTEG)" "$(BR_REVIEW)"; \
		else printf "  $(YELLOW)⚠  %s is %s commits behind %s — merge it down after a promote$(RESET)\n" "$(BR_INTEG)" "$$N" "$(BR_REVIEW)"; fi; \
	fi
	@for b in $$(git branch --format='%(refname:short)' | grep -vE '^(master|main)$$'); do \
		git rev-parse --verify --quiet "origin/$$b" >/dev/null || printf "  $(YELLOW)⚠  %s exists only locally — push it or lose it$(RESET)\n" "$$b"; \
	done
	@echo ""
	@echo "$(BLUE)Patched files outside the payload$(RESET)"
	@if $(SITE) health.markers >/dev/null 2>&1; then \
		$(SITE) health.markers | while IFS='|' read -r mp needle; do \
			[ -n "$$mp" ] || continue; \
			for e in $$($(SITE) environments); do \
				H=$$($(SITE) environments.$$e.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
				R=$$($(SITE) environments.$$e.path); \
				N=$$(ssh -qn "$$H" "grep -c -- '$$needle' '$$R/$$mp' 2>/dev/null" | tr -dc '0-9'); \
				if [ "$${N:-0}" -gt 0 ]; then printf "  $(GREEN)%-12s ✅$(RESET) %s\n" "$$e" "$$mp"; \
				else printf "  $(RED)%-12s ❌ PATCH GONE$(RESET) %s — an update reverted it, re-apply\n" "$$e" "$$mp"; fi; \
			done; \
		done; \
	else \
		echo "  (none declared — add health.markers to site.yml for third-party files you patch)"; \
	fi

# ═════════════════════════════════════════════════════════════════════════════
# INTERNAL HELPERS — never call these directly
# ═════════════════════════════════════════════════════════════════════════════

# Transport moves the files. Everything around it — gate, backup, stamp,
# ledger, rollback — is identical whatever the method is.
_deploy-transport:
	@M=$$($(SITE) deploy.method); \
	case "$$M" in \
		rsync)    $(MAKE) --no-print-directory _deploy-rsync env=$(env) dryrun="$(dryrun)";; \
		git-push) $(MAKE) --no-print-directory _deploy-gitpush env=$(env) dryrun="$(dryrun)";; \
		*) echo "$(RED)✗ Unknown deploy.method: $$M (expected rsync or git-push)$(RESET)"; exit 1;; \
	esac

_deploy-rsync:
	@ENV="$(env)"; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	REMOTE=$$($(SITE) environments.$$ENV.path); \
	EXCL=""; \
	set -f; for e in $$($(SITE) deploy.exclude); do EXCL="$$EXCL --exclude=$$e"; done; set +f; \
	for p in $$($(SITE) deploy.payload); do \
		if [ ! -d "$(WEBROOT)/$$p" ]; then \
			echo "$(RED)✗ Payload path missing locally: $(WEBROOT)/$$p$(RESET)"; exit 1; \
		fi; \
		echo "$(BLUE)  → $$p$(RESET)"; \
		rsync -az --delete -e "ssh -q" $(dryrun) --itemize-changes $$EXCL \
			"$(WEBROOT)/$$p/" "$$HOST:$$REMOTE/$$p/" || exit 1; \
	done

# Ploi/Bedrock. A push alone does NOT deploy: Ploi may have no repository
# connected, and PHP-FPM often runs opcache.validate_timestamps=0, so a pull
# stays invisible until FPM is reloaded. Every step is required, in order.
_deploy-gitpush:
	@ENV="$(env)"; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	REMOTE=$$($(SITE) environments.$$ENV.path); \
	BRANCH=$$($(SITE) environments.$$ENV.branch); \
	if [ -n "$(dryrun)" ]; then \
		echo "$(YELLOW)  would: git push origin $$BRANCH$(RESET)"; \
		echo "$(YELLOW)  would: ssh $$HOST 'cd $$REMOTE && git pull --ff-only origin $$BRANCH'$(RESET)"; \
		$(SITE) deploy.post_deploy_hooks 2>/dev/null | while read -r c; do \
			[ -n "$$c" ] && echo "$(YELLOW)  would: ssh $$HOST 'cd $$REMOTE && $$c'$(RESET)"; \
		done; \
		exit 0; \
	fi; \
	echo "$(BLUE)  → push $$BRANCH$(RESET)"; \
	git push --quiet origin "$$BRANCH" || exit 1; \
	echo "$(BLUE)  → pull on $$ENV$(RESET)"; \
	ssh -qn "$$HOST" "cd $$REMOTE && git pull --ff-only origin $$BRANCH" || exit 1; \
	$(SITE) deploy.post_deploy_hooks 2>/dev/null | while read -r c; do \
		[ -z "$$c" ] && continue; \
		echo "$(BLUE)  → $$c$(RESET)"; \
		ssh -qn "$$HOST" "cd $$REMOTE && $$c" || exit 1; \
	done

_deploy-gate:
	@ENV="$(env)"; \
	if [ -z "$$ENV" ]; then \
		echo "$(RED)✗ Usage: make deploy env=<development|staging|production>$(RESET)"; \
		exit 1; \
	fi; \
	WANT=$$($(SITE) environments.$$ENV.branch 2>/dev/null); \
	if [ -z "$$WANT" ]; then \
		echo "$(RED)✗ Unknown environment: $$ENV$(RESET)"; \
		echo "$(YELLOW)Known: $$($(SITE) environments | tr '\n' ' ')$(RESET)"; \
		exit 1; \
	fi; \
	HAVE=$$(git branch --show-current); \
	if [ "$$HAVE" != "$$WANT" ]; then \
		echo "$(RED)✗ $$ENV deploys from '$$WANT' — you are on '$$HAVE'$(RESET)"; \
		exit 1; \
	fi; \
	if [ -n "$$(git status --porcelain)" ]; then \
		echo "$(RED)✗ Uncommitted changes — nothing uncommitted reaches a server$(RESET)"; \
		git status --short; \
		exit 1; \
	fi; \
	if ! git remote get-url origin >/dev/null 2>&1; then \
		echo "$(RED)✗ no 'origin' remote — nothing can be deployed that is not pushed$(RESET)"; \
		echo "$(YELLOW)  git remote add origin <url> && git push -u origin $$WANT$(RESET)"; \
		exit 1; \
	fi; \
	git fetch --quiet origin "$$WANT" 2>/dev/null || { echo "$(RED)✗ origin is unreachable — the gate cannot verify that HEAD is pushed$(RESET)"; exit 1; }; \
	if ! git merge-base --is-ancestor HEAD "origin/$$WANT" 2>/dev/null; then \
		echo "$(RED)✗ HEAD is not on origin/$$WANT — push before deploying$(RESET)"; \
		exit 1; \
	fi; \
	echo "$(GREEN)✓ gate passed: $$ENV ← $$WANT @ $$(git rev-parse --short HEAD)$(RESET)"

_deploy-confirm:
	@ENV="$(env)"; \
	if [ "$$($(SITE) environments.$$ENV.confirm)" != "true" ]; then exit 0; fi; \
	$(MAKE) --no-print-directory _need-tty verb="deploy env=$$ENV"; \
	echo "$(RED)╔════════════════════════════════════════╗$(RESET)"; \
	echo "$(RED)║   DEPLOY TO $$ENV$(RESET)"; \
	echo "$(RED)║   $$($(SITE) environments.$$ENV.role)$(RESET)"; \
	echo "$(RED)╚════════════════════════════════════════╝$(RESET)"; \
	git --no-pager log --oneline "deployed/$$ENV..HEAD" 2>/dev/null | head -20 || true; \
	read -p "Type 'yes' to deploy: " reply; \
	if [ "$$reply" != "yes" ]; then echo "$(RED)✗ Cancelled$(RESET)"; exit 1; fi

_deploy-stamp:
	@ENV="$(env)"; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	DIR=$$($(SITE) deploy.state_dir); \
	SHA=$$(git rev-parse HEAD); \
	BRANCH=$$(git branch --show-current); \
	WHEN=$$(date -Iseconds); \
	WHO=$$(git config user.name); \
	printf '{"sha":"%s","branch":"%s","at":"%s","by":"%s"}\n' "$$SHA" "$$BRANCH" "$$WHEN" "$$WHO" \
		| ssh -q "$$HOST" "mkdir -p $$DIR && cat > $$DIR/$$ENV.json"; \
	printf '%s %s %s %s\n' "$$WHEN" "$$SHA" "$$BRANCH" "$$WHO" \
		| ssh -q "$$HOST" "cat >> $$DIR/$$ENV.log"; \
	git tag -f "deployed/$$ENV" >/dev/null; \
	git push -f --quiet origin "deployed/$$ENV" 2>/dev/null || \
		echo "$(YELLOW)  (tag not pushed — no network?)$(RESET)"; \
	echo "$(GREEN)✓ stamped $$ENV @ $$(git rev-parse --short HEAD)$(RESET)"

_deploy-opcache:
	@ENV="$(env)"; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	REMOTE=$$($(SITE) environments.$$ENV.path); \
	URL=$$($(SITE) environments.$$ENV.url); \
	NAME=".opcache-$$(git rev-parse --short HEAD)-$$$$.php"; \
	echo '<?php opcache_reset(); echo "ok"; unlink(__FILE__);' \
		| ssh -q "$$HOST" "cat > $$REMOTE/$$NAME"; \
	curl -fsS --max-time 20 "$$URL/$$NAME" >/dev/null 2>&1 || true; \
	ssh -qn "$$HOST" "rm -f $$REMOTE/$$NAME"; \
	echo "$(GREEN)✓ opcache reset on $$ENV$(RESET)"

_backup-payload:
	@ENV="$(env)"; \
	HOST=$$($(SITE) environments.$$ENV.ssh_host 2>/dev/null || $(SITE) deploy.ssh_host); \
	REMOTE=$$($(SITE) environments.$$ENV.path); \
	DIR=$$($(SITE) deploy.state_dir); \
	STAMP=$$(date +%Y%m%d-%H%M%S); \
	PATHS=$$($(SITE) deploy.payload | tr '\n' ' '); \
	echo "$(YELLOW)Backing up $$ENV payload directories...$(RESET)"; \
	ARCHIVE="$$DIR/backups/$$ENV-$$STAMP.tar.gz"; \
	: "GNU tar exits 1 for warnings (a file changed while being read) and 2"; \
	: "for real errors. Treating any non-zero as failure aborts a ship over a"; \
	: "warning, so check the archive itself instead."; \
	ssh -qn "$$HOST" "mkdir -p $$DIR/backups && cd $$REMOTE && tar czf $$ARCHIVE $$PATHS 2>/dev/null; rc=\$$?; [ \$$rc -le 1 ] || exit \$$rc"; \
	SIZE=$$(ssh -qn "$$HOST" "stat -c %s $$ARCHIVE 2>/dev/null || echo 0"); \
	if [ "$$SIZE" -lt 1024 ]; then \
		echo "$(RED)✗ Payload backup missing or empty ($$SIZE bytes) — not deploying$(RESET)"; exit 1; \
	fi; \
	echo "$(GREEN)✓ payload backed up: $$ARCHIVE ($$(( SIZE / 1024 )) KB)$(RESET)"


# A rung checked out in ANOTHER worktree cannot be checked out here, and every
# promoting verb does `git checkout <rung>`. Without this, `make finish` inside
# a linked worktree died on a raw git error mid-verb —
#   fatal: 'development' is already used by worktree at ...
# — which is exactly the shape `_ensure-flow` exists to prevent: a half-run
# verb dying on a git error is what taught agents to fall back to raw git.
#
# Parallel agents each get their own worktree, so this is the normal case there,
# not an edge one. Refusing is also the right answer on the merits: N agents
# merging into one shared rung concurrently is a race. The merge serialises
# through whichever worktree holds the rung.
#
# Usage: $(MAKE) _worktree-guard rung=<branch> verb=<name>
_worktree-guard:
	@RUNG="$(rung)"; [ -n "$$RUNG" ] || exit 0; \
	HOLDER=$$(git worktree list --porcelain 2>/dev/null \
		| awk -v b="refs/heads/$$RUNG" \
			'/^worktree /{w=substr($$0,10)} /^branch /{if ($$2==b) {print w; exit}}'); \
	[ -n "$$HOLDER" ] || exit 0; \
	HERE=$$(git rev-parse --show-toplevel 2>/dev/null); \
	[ "$$HOLDER" = "$$HERE" ] && exit 0; \
	echo "$(RED)✗ make $(verb) needs to check out '$$RUNG', which is checked out in another worktree$(RESET)"; \
	echo "$(YELLOW)  held by: $$HOLDER$(RESET)"; \
	echo "$(YELLOW)  here:    $$HERE$(RESET)"; \
	echo ""; \
	BR=$$(git branch --show-current); \
	case "$$BR" in \
		feature/*|hotfix/*) \
			echo "$(YELLOW)  Finish it from there, naming this branch:$(RESET)"; \
			echo "$(YELLOW)    cd $$HOLDER && make finish name=$${BR#*/}$(RESET)";; \
		*) \
			echo "$(YELLOW)  Run the verb where the rung lives:$(RESET)"; \
			echo "$(YELLOW)    cd $$HOLDER && make $(verb)$(RESET)";; \
	esac; \
	echo "$(YELLOW)  Your commits are already visible from there — a worktree shares$(RESET)"; \
	echo "$(YELLOW)  the repository, so nothing needs pushing first.$(RESET)"; \
	exit 1

# Where am I in the flow, and what is the next verb — printed FIRST by help,
# status and doctor, so the answer is on screen before anything is typed.
_flow-state:
	@echo "$(BLUE)Flow$(RESET)"
	@if URL=$$(git remote get-url origin 2>/dev/null); then printf "  origin:  %s\n" "$$URL"; \
	else printf "  origin:  $(RED)MISSING$(RESET) — git remote add origin <url>\n"; fi
	@BRANCH=$$(git branch --show-current 2>/dev/null || echo none); \
	ROLE=$$($(MAKE) --no-print-directory _branch-role); \
	printf "  branch:  %s  (%s)\n" "$$BRANCH" "$$ROLE"; \
	case "$$ROLE" in \
		feature) printf "  next:    commit, then make finish  → $(BR_INTEG)\n";; \
		hotfix)  printf "  next:    commit, then make finish  → $(BR_PROD), then back down\n";; \
		rung:*)  printf "  next:    make feature name=<x>  (a rung is deploy-only)\n";; \
		none)    printf "  next:    git checkout $(BR_INTEG), then make feature name=<x>\n";; \
		*)       printf "  next:    make feature name=<x>  (this branch is outside the flow)\n";; \
	esac
	@for b in $(BR_INTEG) $(BR_REVIEW) $(BR_PROD); do \
		if git rev-parse --verify --quiet "origin/$$b" >/dev/null 2>&1; then printf "  rung:    %-14s on origin\n" "$$b"; \
		else printf "  rung:    %-14s $(YELLOW)not on origin$(RESET)\n" "$$b"; fi; \
	done

# feature | hotfix | rung:<env> | other | none — the one classifier every flow line reads.
_branch-role:
	@BRANCH=$$(git branch --show-current 2>/dev/null); \
	if [ -z "$$BRANCH" ]; then echo none; exit 0; fi; \
	case "$$BRANCH" in feature/*) echo feature; exit 0;; hotfix/*) echo hotfix; exit 0;; esac; \
	for e in $$($(SITE) environments 2>/dev/null); do \
		if [ "$$($(SITE) environments.$$e.branch 2>/dev/null)" = "$$BRANCH" ]; then echo "rung:$$e"; exit 0; fi; \
	done; \
	echo other

# The flow floor: a rung branch is deploy-only. This target REFUSES and names
# the verb — it never switches you and never creates a branch. The old
# behaviour (silently `git checkout -b develop` off master) healed a wrong
# topology invisibly, which is how commits landed on the wrong rung.
_ensure-safe-branch:
	@BRANCH=$$(git branch --show-current 2>/dev/null || echo "none"); \
	ROLE=$$($(MAKE) --no-print-directory _branch-role); \
	case "$$ROLE" in \
		rung:*) \
			echo "$(RED)✗ '$$BRANCH' is the $${ROLE#rung:} branch — a rung is deploy-only, never worked on$(RESET)"; \
			echo "$(YELLOW)  make feature name=<x>   (or: make hotfix name=<x> for a production fix)$(RESET)"; \
			exit 1;; \
		none) \
			echo "$(RED)✗ no branch checked out$(RESET)"; \
			echo "$(YELLOW)  git checkout $(BR_INTEG)   then: make feature name=<x>$(RESET)"; \
			exit 1;; \
	esac

_warn-rung-branch:
	@ROLE=$$($(MAKE) --no-print-directory _branch-role); \
	case "$$ROLE" in rung:*) \
		echo "$(YELLOW)⚠  on the $${ROLE#rung:} branch — fine for looking, not for editing: make feature name=<x> before you change anything$(RESET)";; \
	esac

# A confirming verb reads its `yes` from a HUMAN. Piped or redirected stdin is
# not a terminal, so it is refused — `echo yes | make ship` and
# `make ship < answers` both stop here.
_need-tty:
	@if [ ! -t 0 ]; then \
		echo "$(RED)✗ make $(verb) needs a terminal — its confirmation is typed by a human, never piped or redirected$(RESET)"; \
		exit 1; \
	fi

# The flow needs a remote and its rungs on it. Refuse by name — a half-run verb
# dying on a git error is exactly what taught agents to fall back to raw git.
_ensure-flow:
	@if ! git remote get-url origin >/dev/null 2>&1; then \
		echo "$(RED)✗ no 'origin' remote — the branch flow needs one$(RESET)"; \
		echo "$(YELLOW)  git remote add origin <url>$(RESET)"; \
		echo "$(YELLOW)  git push -u origin $(BR_INTEG)      (and $(BR_REVIEW) / $(BR_PROD) once they exist)$(RESET)"; \
		exit 1; \
	fi; \
	git fetch --quiet --prune origin 2>/dev/null || { echo "$(RED)✗ origin is unreachable — check the URL or your network before running the flow$(RESET)"; exit 1; }; \
	for b in $(BR_INTEG) $(BR_REVIEW) $(BR_PROD); do \
		git rev-parse --verify --quiet "origin/$$b" >/dev/null || { \
			echo "$(RED)✗ origin has no '$$b' branch — the flow promotes through it$(RESET)"; \
			echo "$(YELLOW)  git checkout -b $$b <base> && git push -u origin $$b$(RESET)"; exit 1; }; \
		if git rev-parse --verify --quiet "$$b" >/dev/null; then \
			N=$$(git rev-list --count "origin/$$b..$$b" 2>/dev/null || echo 0); \
			if [ "$$N" != "0" ]; then \
				echo "$(RED)✗ local '$$b' carries $$N commit(s) that are not on origin — a rung is written only by the flow, and finish would push them$(RESET)"; \
				echo "$(YELLOW)  from another branch: git branch -f $$b origin/$$b   (rescue the commits onto a feature branch first if they matter)$(RESET)"; exit 1; \
			fi; \
		fi; \
	done

_ensure-clean-git:
	@if [ -n "$$(git status --porcelain)" ]; then \
		echo "$(RED)❌ You have uncommitted changes$(RESET)"; \
		echo "$(YELLOW)Run 'make save' first$(RESET)"; \
		exit 1; \
	fi

# Data moves backward only. Every verb that overwrites an environment's data
# routes through this first.
_refuse-production:
	@ENV="$(env)"; \
	if [ -z "$$ENV" ]; then echo "$(RED)✗ Usage: env=<staging|development>$(RESET)"; exit 1; fi; \
	if [ "$$ENV" = "production" ]; then \
		echo "$(RED)✗ Refused: data moves backward only, never into production$(RESET)"; exit 1; \
	fi; \
	if [ -z "$$($(SITE) environments.$$ENV.path)" ]; then \
		echo "$(RED)✗ Unknown environment: $$ENV$(RESET)"; exit 1; \
	fi

_check-requirements:
	@for c in git rsync ssh python3; do \
		command -v $$c >/dev/null 2>&1 || { echo "$(RED)❌ $$c not installed$(RESET)"; exit 1; }; \
	done

.PHONY: _deploy-transport _deploy-rsync _deploy-gitpush _deploy-gate _deploy-confirm \
        _deploy-stamp _deploy-opcache _backup-payload _flow-state \
        _branch-role _ensure-safe-branch _warn-rung-branch _need-tty _ensure-flow \
        _ensure-clean-git _refuse-production _check-requirements _worktree-guard
