# ─────────────────────────────────────────────────────────────────────────────
# Netdust project — shared base. Rendered from netdust-devops/templates/.
#
# NEVER ignore these. The deploy pipeline cannot work without them, and a fresh
# clone must be able to deploy:
#   site.yml           every host, path, branch and hook the Makefile reads
#   Makefile           yours: STACK + project-specific targets
#   Makefile.netdust   the vendored devops core
#   mk/                the vendored stack layer
#   scripts/           scripts/site is the reader; Make cannot parse YAML
#   .netdust-devops    the vendored version + checksums `make doctor` reads
#
# One project once ignored /site.yml, and a fresh clone could not deploy at all.
# ─────────────────────────────────────────────────────────────────────────────

# Agent notes — local only, never shipped to a server
memory/
tasks/
**/memory/.stop-hook-state.json

# Dotenv
.env
.env.*
!.env.example

# Dependencies
/vendor
/node_modules
auth.json

# Logs and backups
*.log
backups/

# Tests
.phpunit.cache/
playwright-report/
test-results/
# Playwright storageState holds a live session cookie — never commit
tests/e2e/.auth/

# Editor and OS junk
.idea/
.DS_Store
Thumbs.db
# WSL attaches these alternate-data-stream stubs to files dragged from Windows
*:Zone.Identifier

