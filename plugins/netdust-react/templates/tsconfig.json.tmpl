{
  "//": "netdust-react strict TypeScript base for a single Vite + React app. Harvested from netdust-expo/templates/tsconfig.base.json.tmpl, de-monorepo'd and re-targeted from react-native to the DOM. RULES.md rule 6 — these flags are not per-project negotiable.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "//exactOptionalPropertyTypes": "Deliberately OFF by default here, unlike netdust-expo. Most React/Radix prop types are written as `prop?: T` while passing `undefined` explicitly, so turning it on produces friction at every component boundary for little gain in UI code. Turn it ON for a project whose value lives in shared Zod schemas and data modelling.",
    "exactOptionalPropertyTypes": false,

    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true,
    "incremental": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "*.config.ts", "*.config.mts"],
  "exclude": ["node_modules", "dist", "android", "ios", "playwright-report"]
}
