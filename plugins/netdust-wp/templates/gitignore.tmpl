# ─────────────────────────────────────────────────────────────────────────────
# SHARED BLOCK — identical in every Netdust WordPress project.
# Edit it in netdust-wp/templates/gitignore.tmpl, never in one project only.
#
# NEVER ignore these — the deploy pipeline cannot work without them:
#   site.yml   every host, path, branch and hook the Makefile reads
#   scripts/   scripts/site is the reader; Make cannot parse YAML
#   Makefile
# daan had /site.yml ignored, so a fresh clone could not deploy (fixed 2026-08-31).
# ─────────────────────────────────────────────────────────────────────────────

# Agent Layer-C notes — local only, never shipped to a server
memory/
tasks/
**/memory/.stop-hook-state.json

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# Node
/node_modules

# Logs and backups
*.log
backups/

# WP-CLI
wp-cli.local.yml

# Tests
.phpunit.cache/
playwright-report/
test-results/
# Playwright storageState holds a live session cookie — never commit
tests/e2e/.auth/

# WordPress core and generated content — Bedrock (web/) and custom-app (app/).
# A pattern for a layout this project does not use is inert, so both are listed.
web/wp
web/.htaccess
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*
app/wp/*
app/vendor/*
app/content/upgrade
app/content/uploads/*
!app/content/uploads/.gitkeep
app/content/cache/*

# Editor and OS junk
.idea/
.DS_Store
Thumbs.db
# WSL attaches these alternate-data-stream stubs to files dragged from Windows
*:Zone.Identifier

