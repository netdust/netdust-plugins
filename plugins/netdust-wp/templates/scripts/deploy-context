#!/usr/bin/env bash
# One line telling Claude which branch is checked out and where it deploys.
cd "$(dirname "$0")/.." || exit 0
BRANCH=$(git branch --show-current 2>/dev/null) || exit 0
[ -n "$BRANCH" ] || exit 0

TARGET=""
for env in development staging production; do
  if [ "$(scripts/site environments.$env.branch 2>/dev/null)" = "$BRANCH" ]; then
    TARGET="$env  ($(scripts/site environments.$env.url))  — $(scripts/site environments.$env.role)"
    break
  fi
done

if [ -n "$TARGET" ]; then
  echo "Branch: $BRANCH  →  deploys to $TARGET"
else
  echo "Branch: $BRANCH  →  deploys nowhere directly (promote with: make finish)"
fi
