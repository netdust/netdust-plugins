# site.yml — operational config for {{PROJECT_NAME}}
# Read into context at session start by the netdust session-start hook.
# Keep the top-level keys (site / structure / hosting / deploy / local /
# commands) — the hook greps them to surface deploy + risk info BEFORE
# you're asked to ship, plus the commands test/gate bindings.

site:
  name: {{PROJECT_NAME}}
  domain: {{DOMAIN}}                 # production domain, e.g. example.com
  description: {{DESCRIPTION}}        # one line: what this site is
  risk: {{RISK}}                      # low | medium | high — "high" means triple-check destructive ops

structure:
  type: {{STACK_TYPE}}               # bedrock | custom-app | custom-site
  webroot: {{WEBROOT}}                       # bedrock: web | custom-app: app | custom-site: .
  wpcli_path: {{WPCLI_PATH}}                 # bedrock: web/wp | custom-app: app/wp (matches wp-cli.yml --path)
  theme_flavour: {{THEME_FLAVOUR}}           # yootheme | custom | tbd
  # yootheme = YOOtheme Pro parent + thin child; builder renders, styling lives in
  #   less/theme.<slug>.less. The child carries NO template files, no CSS toolchain.
  #   See netdust-wp:ntdst-yootheme → references/yootheme-less.md.
  #   NOTE: the licensed parent is gitignored and must be installed per host.
  # custom = self-rendering theme with its own templates (Tailwind/Alpine/Vite).

hosting:
  provider: {{HOSTING_PROVIDER}}     # ploi | combell | other
  ssh_staging: {{SSH_STAGING}}       # ssh alias for staging (or "" if none)
  ssh_production: {{SSH_PRODUCTION}}  # ssh alias for production

# The promotion targets. The Makefile reads these for every deploy: which
# branch may reach which environment, where it lives, and whether it prompts.
# Promotion is linear. A project without a development environment integrates
# on its review branch; one without production yet simply omits it.
environments:
  # development:                     # optional — a public sandbox you may break
  #   url: https://dev.{{DOMAIN}}
  #   path: TODO                     # absolute path on the server
  #   branch: develop
  #   role: "sandbox — may break"
  #   confirm: false
  staging:
    url: https://staging.{{DOMAIN}}
    path: TODO                       # absolute path on the server
    branch: staging
    role: "colleague-facing — keep stable"
    confirm: false
    # ssh_host: overrides deploy.ssh_host for this environment
  production:
    url: https://{{DOMAIN}}
    path: TODO                       # absolute path on the server
    branch: main
    role: "live"
    confirm: true                    # production ALWAYS prompts
    backup_before: true

deploy:
  # rsync    — move a closed payload; the environment directory is the web root
  # git-push — push, pull on the server, then post_deploy (Ploi/Bedrock)
  method: {{DEPLOY_METHOD}}
  staging_command: make deploy env=staging
  production_command: make ship
  ssh_host: {{SSH_STAGING}}          # default; an environment may override it
  wp_path: TODO                      # WP core ON THE SERVER, relative to the env path
                                     # bedrock: web/wp · custom-app: wp · standard: "" (root)
  content_dir: TODO                  # wp-content ON THE SERVER, relative to the env path
                                     # bedrock: web/app · custom-app: content
  state_dir: TODO                    # the ledger, OUTSIDE every web root (env dirs are served)

  # rsync only. A closed list — nothing outside it ever crosses the wire: not
  # wp/, not vendor/, not uploads/, not a third-party plugin. Every entry must
  # exist locally AND be tracked in git, or it deploys as an empty directory
  # and a rollback --deletes it off the server.
  payload: []
  exclude:
    # Never add "*.map" — font-encoding tables are not JavaScript source maps.
    - ".git*"
    - "node_modules"
    - "*.log"

  # git-push only. A push alone does NOT deploy: Ploi may have no repository
  # connected, and PHP-FPM often runs opcache.validate_timestamps=0, so the
  # pull stays invisible until FPM is reloaded. Declare the steps here.
  post_deploy_hooks: []
  #  - composer install --no-dev --no-interaction
  #  - sudo service php8.4-fpm reload

  note: {{DEPLOY_NOTE}}              # anything non-obvious about this site's deploy

local:
  ddev_project: {{PROJECT_NAME}}     # DDEV project name
  url: https://{{PROJECT_NAME}}.ddev.site

commands:
  # Agent bindings (netdust harness): per-task test suite + the full gate.
  # `make gate` runs the gate value below; `make test` runs the deploy
  # tooling's own tests, which never contact a server.
  # The gate's exit code is the single source of truth — see README-testing.md.
  test: ddev composer test:unit
  gate: composer gate          # host-invoked; runs every tier (ddev gate works too)
