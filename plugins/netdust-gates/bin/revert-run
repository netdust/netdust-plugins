#!/usr/bin/env bash
# revert-run — prove ONE e2e test can fail: put the base's version of the branch's changed
# non-test files back in the working tree, run that test, restore the tree whatever happens,
# and write a classified log the shake-out checker reads.
#
#   revert-run <feature> <test-path> <test-title> -- <command running that one test…>
#
# Writes specs/<feature>/shakeout/<stem>.revert.log, <stem> = the test path with / as __,
# then --, then the title slugged. Its first line is `revert-run: assertion-failed`, `passed`
# or `error`. Exit 0 when the log was written, 2 on refusal or a git error. Never commits,
# never touches an untracked file, never swaps tests/ or specs/.
set -uo pipefail

usage() { echo "usage: revert-run <feature> <test-path> <test-title> -- <command running that one test>" >&2; exit 2; }
[ $# -ge 5 ] && [ "$4" = "--" ] || usage
feature=$1 test_path=$2 title=$3
shift 4

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "revert-run: not inside a git repository" >&2; exit 2; }
cd "$root" || exit 2

production_ref() {
    local b c
    b=$([ -x scripts/site ] && scripts/site environments.production.branch 2>/dev/null || true)
    for c in "$b" main master; do
        [ -n "$c" ] || continue
        git rev-parse -q --verify "origin/$c^{commit}" >/dev/null 2>&1 && { echo "origin/$c"; return; }
        git rev-parse -q --verify "refs/heads/$c^{commit}" >/dev/null 2>&1 && { echo "$c"; return; }
    done
    return 1
}

ref=$(production_ref) || { echo "revert-run: no production branch — scripts/site environments.production.branch, main or master" >&2; exit 2; }
base=$(git merge-base "$ref" HEAD) || { echo "revert-run: no merge-base between $ref and HEAD" >&2; exit 2; }

# The swap set, by status: M (and T, a type change) and D come back from the base, A is removed.
modified=() added=() deleted=()
while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    case "$path" in tests/*|specs/*) continue ;; esac
    case "$status" in
        M|T) modified+=("$path") ;;
        A)   added+=("$path") ;;
        D)   deleted+=("$path") ;;
        *)   echo "revert-run: unexpected status $status for $path" >&2; exit 2 ;;
    esac
done < <(git diff -z --no-renames --name-status "$base" HEAD)
swap=("${modified[@]}" "${added[@]}" "${deleted[@]}")
[ ${#swap[@]} -gt 0 ] || { echo "revert-run: nothing to swap — the branch changes no file outside tests/ and specs/" >&2; exit 2; }

# Refuse before touching anything: an edit the swap would overwrite, or an untracked file at a
# path the branch deleted (the base checkout would overwrite it).
dirty=$(git status --porcelain --untracked-files=all -- "${swap[@]}")
if [ -n "$dirty" ]; then
    echo "revert-run: refused — the swap set is not clean:" >&2
    while IFS= read -r line; do
        case "$line" in
            '??'*) echo "  ${line#?? } is untracked at a path the branch deleted — move it first" >&2 ;;
            *)     echo "  ${line#???} has uncommitted changes — commit or discard them first" >&2 ;;
        esac
    done <<< "$dirty"
    exit 2
fi

restore() {
    if [ ${#modified[@]} -gt 0 ] || [ ${#added[@]} -gt 0 ]; then
        git checkout -q HEAD -- "${modified[@]}" "${added[@]}"
    fi
    local p
    for p in "${deleted[@]}"; do
        git rm -q --cached --ignore-unmatch -- "$p"
        rm -f -- "$p"
    done
}
trap restore EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ ${#modified[@]} -gt 0 ] || [ ${#deleted[@]} -gt 0 ]; then
    git checkout -q "$base" -- "${modified[@]}" "${deleted[@]}" || exit 2
fi
for p in "${added[@]}"; do rm -f -- "$p"; done

out=$(mktemp)
trap 'rm -f -- "$out"; restore' EXIT
"$@" > "$out" 2>&1 &
child=$!
on_signal() { kill -TERM "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 130; }
trap on_signal INT TERM
wait "$child"
rc=$?
trap - INT TERM
restore

classify() {
    [ "$rc" -ne 0 ] || { echo passed; return; }
    if { grep -qE 'Error: expect\(' "$out" && grep -qE '^[[:space:]]*(Expected|Received)\b' "$out"; } \
        || grep -q 'Failed asserting' "$out"; then echo assertion-failed; return; fi
    echo error
}
class=$(classify)

total=$(wc -l < "$out")
marker=$(grep -nE 'Error: expect\(|Failed asserting' "$out" | head -1 | cut -d: -f1)
[ -n "$marker" ] || marker=$(grep -nE 'TimeoutError|Error:' "$out" | head -1 | cut -d: -f1)
if [ -n "$marker" ]; then
    first=$(( marker - 5 )); [ "$first" -ge 1 ] || first=1
else
    first=$(( total - 19 )); [ "$first" -ge 1 ] || first=1
fi
last=$(( first + 19 )); [ "$last" -le "$total" ] || last=$total

slug=$(printf '%s' "$title" | LC_ALL=C tr 'A-Z' 'a-z' | LC_ALL=C tr -cs 'a-z0-9' '-')
stem="${test_path//\//__}--${slug}"
log="specs/$feature/shakeout/$stem.revert.log"
mkdir -p "specs/$feature/shakeout"
{
    echo "revert-run: $class"
    echo "feature: $feature"
    echo "test: $test_path :: $title"
    echo "base: $(git rev-parse --short=7 "$base") ($ref)"
    for p in "${modified[@]}"; do echo "swapped: $p (M)"; done
    for p in "${added[@]}";    do echo "swapped: $p (A)"; done
    for p in "${deleted[@]}";  do echo "swapped: $p (D)"; done
    printf 'command:'; printf ' %q' "$@"; echo
    echo "exit: $rc"
    echo "--- output: $total lines, excerpt $first-$last ---"
    sed -n "${first},${last}p" "$out"
} > "$log"
echo "revert-run: $class — $log"
