#!/usr/bin/env bash
# herdr stand-in for run-evals.py (a case's stub_bin): logs every call to $EVAL_ROOT/.herdr/calls.log
# and answers in herdr 0.9.5's shapes. It contacts no server.
set -u
dir="${EVAL_ROOT:?the herdr stub runs only under run-evals.py}/.herdr"
log="$dir/calls.log"
wt="$dir/wt"
ws="wE"
pane="wE:p1"
mkdir -p "$dir"
printf '%s\n' "$*" >> "$log"

opt() {
    local flag=$1
    shift
    while [ $# -gt 0 ]; do
        [ "$1" = "$flag" ] && { printf '%s' "${2:-}"; return; }
        shift
    done
}

worktree_create() {
    local branch base current
    branch=$(opt --branch "$@")
    base=$(opt --base "$@")
    current=$(git -C "$EVAL_ROOT" symbolic-ref --short -q HEAD)
    if [ -z "$branch" ] || [ "$branch" = "$current" ]; then
        printf 'stub: --branch %s is checked out at the sandbox root (git refuses it); the worktree gets %s\n' \
            "${branch:-<none>}" "${branch:-eval}-wt" >> "$log"
        branch="${branch:-eval}-wt"
    fi
    if [ -n "$base" ] && ! git -C "$EVAL_ROOT" rev-parse -q --verify "$base^{commit}" > /dev/null; then
        printf 'stub: --base %s does not exist in the sandbox; the worktree is cut from HEAD\n' "$base" >> "$log"
        base=""
    fi
    if [ ! -d "$wt" ]; then
        if git -C "$EVAL_ROOT" show-ref -q --verify "refs/heads/$branch"; then
            git -C "$EVAL_ROOT" worktree add -q "$wt" "$branch" >&2 || exit 1
        else
            git -C "$EVAL_ROOT" worktree add -q -b "$branch" "$wt" ${base:+"$base"} >&2 || exit 1
        fi
    fi
    printf '{"id":"cli:worktree:create","result":{"worktree":{"path":"%s","branch":"%s"},"workspace":{"workspace_id":"%s","root_pane_id":"%s"},"pane":{"pane_id":"%s"}}}\n' \
        "$wt" "$branch" "$ws" "$pane" "$pane"
}

case "${1:-} ${2:-}" in
    "--skill"* | "--help"* | "help"*)
        echo "herdr 0.9.5 (eval stub). worktree create --branch <B> [--base <REF>]; api snapshot;"
        echo "pane split --current --direction right --no-focus;"
        echo "agent start <NAME> --kind <KIND> --pane <ID> [-- AGENT_ARG...]; agent prompt <TARGET> <TEXT>;"
        echo "agent wait <TARGET>; agent read <TARGET>."
        ;;
    "worktree create")
        worktree_create "$@"
        ;;
    "api snapshot")
        printf '{"id":"cli:api:snapshot","result":{"workspaces":[{"workspace_id":"%s","cwd":"%s","panes":[{"pane_id":"%s","cwd":"%s"}]}]}}\n' \
            "$ws" "$wt" "$pane" "$wt"
        ;;
    "pane split")
        printf '{"id":"cli:pane:split","result":{"pane":{"pane_id":"wE:p2"}}}\n'
        ;;
    "agent start")
        touch "$dir/agent-start"
        printf '{"id":"cli:agent:start","result":{"agent":{"name":"%s","pane_id":"%s","agent_status":"idle"}}}\n' \
            "${3:-coder}" "$(opt --pane "$@")"
        ;;
    "agent wait" | "agent get")
        printf '{"id":"cli:agent:%s","result":{"agent":{"name":"%s","agent_status":"done"}}}\n' "$2" "${3:-coder}"
        ;;
    "agent prompt")
        printf '{"id":"cli:agent:prompt","result":{"submitted":true}}\n'
        ;;
    *)
        printf '{"id":"cli:stub","result":{}}\n'
        ;;
esac
