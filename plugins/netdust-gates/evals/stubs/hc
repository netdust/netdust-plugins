#!/usr/bin/env bash
# hc stand-in for run-evals.py (a case's stub_bin): logs every call to $EVAL_ROOT/.hc/calls.log
# and answers in hc 0.1.13's JSON shapes. It contacts no core.
set -u
dir="${EVAL_ROOT:?the hc stub runs only under run-evals.py}/.hc"
mkdir -p "$dir"
printf '%s\n' "$*" >> "$dir/calls.log"

terminal() {
    printf '{"address":"%s","name":"%s","parent":"t1","cwd":"%s","state":"live","turn":0,"labels":{%s}' \
        "$1" "$2" "$EVAL_ROOT" "$3"
}

# The program or template: the first argument after the flags (and their values).
program() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --name | --cwd | --on | --label | --parent | --timeout) shift 2 ;;
            --) shift; break ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    printf '%s' "${1:-}"
}

verb=${1:-}
[ $# -gt 0 ] && shift
case "$verb" in
    --skill | --help | help | "")
        echo "hc 0.1.13 (eval stub). run [--bg] [--name N] [--label K=V] [--outlive-parent] <template|program> [task];"
        echo "get <t>; ls [--all]; wait [<t>] [--children any|all]; send <t> <text>; read <t>; templates."
        ;;
    --version)
        echo "hc 0.1.13"
        ;;
    run)
        prog=$(program "$@")
        [ "$prog" = coder ] && echo coder > "$dir/run-coder"
        terminal t2 "$prog" ""
        printf ',"first_message":{"sent":true,"turn":1}}\n'
        ;;
    get)
        if [ "${1:-}" = t1 ]; then
            printf '{"address":"t1","name":"thinker","parent":null,"cwd":"%s","state":"live","turn":3,"labels":{"herdr.space":"s1"}}\n' "$EVAL_ROOT"
        else
            terminal t2 "${1:-coder}" ""
            printf ',"status":"idle"}\n'
        fi
        ;;
    ls)
        printf '{"hidden_finished":0,"terminals":[{"address":"t1","name":"thinker","state":"live","turn":3,"labels":{"herdr.space":"s1"}}]}\n'
        ;;
    wait)
        printf '{"terminal":"t2","ended":true,"reason":"idle","turn":1,"children":[]}\n'
        ;;
    send)
        printf '{"turn":1,"started":true}\n'
        ;;
    read)
        printf '{"text":"","complete":true,"how":"screen"}\n'
        ;;
    templates)
        printf '{"templates":[{"name":"coder","description":"Executes an approved plan.","command":"claude --permission-mode auto"},{"name":"reviewer","description":"Read-only review.","command":"claude --model opus --permission-mode auto --disallowedTools Edit Write NotebookEdit"},{"name":"sparring","description":"Argues the other side.","command":"claude --model opus --permission-mode auto --disallowedTools Edit Write NotebookEdit"}]}\n'
        ;;
    *)
        printf '{"error":{"kind":"stub","message":"the eval stub does not serve hc %s"}}\n' "$verb"
        exit 2
        ;;
esac
